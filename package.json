{
  "name": "sheet-music-101",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "check:safety": "node scripts/check-safety.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "e2e": "playwright test",
    "verify": "npm run check:safety && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:dist && npm run build:e2e && npm run e2e"
  },
  "dependencies": {
    "@fontsource/nunito": "5.3.0",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  }
}
